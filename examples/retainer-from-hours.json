    {
      "parameters": {
        "jsCode": "// One invoice per client from last month's Toggl Track hours, priced from the Rates sheet.\nconst from = $today.minus({ months: 1 }).startOf('month');\nconst to = $today.startOf('month');\nconst month = from.toFormat('LLLL yyyy');\nconst settings = $('Settings').first().json;\nconst same = (a, b) => String(a ?? '').trim().toLowerCase() === String(b ?? '').trim().toLowerCase();\n\n// Toggl returns a list of time entries (n8n gives one item per entry).\nconst entries = $('Get last month\\'s time entries').all()\n  .flatMap((i) => (Array.isArray(i.json.items) ? i.json.items : [i.json]))\n  .filter((e) => e && e.duration > 0 && e.start)\n  .filter((e) => { const d = DateTime.fromISO(e.start); return d >= from && d < to; })\n  .filter((e) => !settings.billableOnly || e.billable);\n\nconst rates = $('Read rates').all().map((i) => i.json);\nconst rateRow = (client, project) =>\n  rates.find((r) => same(r.Client, client) && same(r.Project, project)) ||\n  rates.find((r) => same(r.Client, client) && !String(r.Project ?? '').trim());\n\nconst clients = {};\nfor (const e of entries) {\n  const client = e.client_name || 'No client';\n  const project = e.project_name || 'No project';\n  const c = (clients[client] ??= {});\n  c[project] = (c[project] ?? 0) + e.duration;\n}\n\nreturn Object.entries(clients).map(([client, projects]) => {\n  const lines = [];\n  const unpriced = [];\n  let email = '';\n  for (const [project, seconds] of Object.entries(projects)) {\n    const r = rateRow(client, project);\n    const hours = Math.round((seconds / 3600) * 100) / 100;\n    if (!r || r['Hourly Rate'] === '' || r['Hourly Rate'] === undefined) { unpriced.push(project); continue; }\n    email = email || r['Billing Email'] || '';\n    lines.push({ description: `${project}, ${month}`, quantity: hours.toFixed(2), unit: 'hours', unit_price: String(r['Hourly Rate']) });\n  }\n  const reason = client === 'No client' ? 'time without a client'\n    : !lines.length ? 'no rate in the Rates sheet'\n    : !email ? 'no Billing Email in the Rates sheet' : '';\n  const hours = (Object.values(projects).reduce((s, sec) => s + sec, 0) / 3600).toFixed(2);\n  return { json: { client, email, month, hours, line_items: lines, unpriced_projects: unpriced, reason } };\n});"
      },
