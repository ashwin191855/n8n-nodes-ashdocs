      "id": "3a181d52-c938-46ae-a370-478cf254d2bb",
      "name": "Read rates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
