    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aa5da755-aa7d-4964-a475-5af0b96507ce",
              "name": "subject",
              "value": "=Quick reminder: invoice {{ $json.invoice_number }}",
              "type": "string"
            },
            {
              "id": "7d86c31e-cb15-4315-a23d-72eae36a3bc6",
              "name": "body",
              "value": "=Hi {{ $json.customer_name }},\n\nJust a friendly reminder that invoice {{ $json.invoice_number }} for {{ $json.amount_due }} was due on {{ $json.due_date_text }}. It may simply have slipped through the cracks.\n\nYou can view and pay it here: {{ $json.pay_link }}\n\nIf you have already paid, thank you, and please ignore this note.\n\nBest,\n{{ $('Settings').first().json.yourName }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "cdac2c02-304b-42b8-ab54-974a7f855f42",
      "name": "Friendly reminder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2160,
        -160
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9fdf7aa8-4f81-44a9-a988-8ecf7d1494a3",
              "name": "subject",
              "value": "=Invoice {{ $json.invoice_number }} is now {{ $json.days_overdue }} days overdue",
              "type": "string"
            },
            {
              "id": "73813261-31cb-477d-a1b4-be89e84cdf21",
              "name": "body",
              "value": "=Hi {{ $json.customer_name }},\n\nInvoice {{ $json.invoice_number }} for {{ $json.amount_due }} was due on {{ $json.due_date_text }} and is now {{ $json.days_overdue }} days overdue. Could you arrange payment this week?\n\nYou can pay online here: {{ $json.pay_link }}\n\nIf something about the invoice is holding it up, reply to this email and I will sort it out.\n\nThanks,\n{{ $('Settings').first().json.yourName }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "efd68e2b-ed25-442f-a740-c025ea638837",
      "name": "Firm reminder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "87a526e0-8141-4bbf-a96d-edf42cdcf0a1",
              "name": "subject",
              "value": "=Final reminder: invoice {{ $json.invoice_number }}",
              "type": "string"
            },
            {
              "id": "1e078dd4-979e-49fe-a5cd-3f50ce085528",
              "name": "body",
              "value": "=Hi {{ $json.customer_name }},\n\nThis is a final reminder that invoice {{ $json.invoice_number }} for {{ $json.amount_due }} is {{ $json.days_overdue }} days overdue (it was due on {{ $json.due_date_text }}).\n\nPlease pay it here: {{ $json.pay_link }}\n\nIf you cannot pay right now, reply and tell me when you can, and we will agree a date.\n\nRegards,\n{{ $('Settings').first().json.yourName }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
