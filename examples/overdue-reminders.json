    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00457a8c-c8b6-4491-aea9-31c3e33bffaa",
              "name": "invoice_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "d8e76401-86cc-4939-aa3c-728375ca8d90",
              "name": "invoice_number",
              "value": "={{ $json.number }}",
              "type": "string"
            },
            {
              "id": "e7ac5c2b-521f-4196-af34-f6a86119e4e9",
              "name": "customer_name",
              "value": "={{ $json.customer?.name || 'there' }}",
              "type": "string"
            },
            {
              "id": "0390fd66-6a01-4684-ae51-a59df801b5d8",
              "name": "customer_email",
              "value": "={{ $json.customer?.email }}",
              "type": "string"
            },
            {
              "id": "11fce0ed-725d-4d2b-a81f-8295018bd7eb",
              "name": "amount_due",
              "value": "={{ $json.totals?.balance_formatted }}",
              "type": "string"
            },
            {
              "id": "9e71add3-b956-41b2-a379-576e328b1380",
              "name": "due_date_text",
              "value": "={{ DateTime.fromISO($json.due_date).toFormat('d LLLL yyyy') }}",
              "type": "string"
            },
            {
              "id": "b9cc46d3-7427-450a-acd4-aa8f36e88368",
              "name": "pay_link",
              "value": "={{ $json.pay_link_url || $json.hosted_url }}",
              "type": "string"
            },
            {
              "id": "b19ee30b-36d4-45f5-ab17-943488aa9246",
              "name": "days_overdue",
              "value": "={{ Math.max(0, Math.floor($today.diff(DateTime.fromISO($json.due_date), 'days').days)) }}",
              "type": "number"
            },
            {
              "id": "3eb6f2e7-949c-4575-ae7b-70ac76b6e7f0",
              "name": "step",
              "value": "={{ (Math.max(0, Math.floor($today.diff(DateTime.fromISO($json.due_date), 'days').days)) <= $('Settings').first().json.friendlyUpToDays ? 'friendly' : Math.max(0, Math.floor($today.diff(DateTime.fromISO($json.due_date), 'days').days)) <= $('Settings').first().json.firmUpToDays ? 'firm' : 'final') }}",
              "type": "string"
            },
            {
              "id": "e6525c98-8f19-432d-a841-0fc312847b72",
              "name": "log_key",
              "value": "={{ $json.number + ' / ' + (Math.max(0, Math.floor($today.diff(DateTime.fromISO($json.due_date), 'days').days)) <= $('Settings').first().json.friendlyUpToDays ? 'friendly' : Math.max(0, Math.floor($today.diff(DateTime.fromISO($json.due_date), 'days').days)) <= $('Settings').first().json.firmUpToDays ? 'firm' : 'final') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
